<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.melodify.musicapp">

    <!-- ==================== Permissions ==================== -->

    <!-- Internet access for streaming songs and Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground service for background playback -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Wake lock to keep CPU awake during playback (prevents audio stutter) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Post notifications (required for Android 13+ to show player notification) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Read external storage (for accessing downloaded songs - legacy support) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Write external storage (for saving downloaded songs - legacy support) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />

    <!-- ==================== Application ==================== -->

    <application
        android:name=".MelodifyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Melodify"
        tools:targetApi="31">

        <!-- ==================== Splash Activity ==================== -->
        <!--
            Splash screen that displays while the app loads.
            Uses a custom theme with no action bar and a background drawable.
            Auto-navigates to MainActivity after a short delay.
        -->
        <activity
            android:name=".feature.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Melodify.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ==================== Main Activity ==================== -->
        <!--
            Main entry point of the application after splash screen.
            Handles configuration changes to prevent activity recreation on keyboard/rotation.
        -->
        <activity
            android:name=".feature.main.MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|locale"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Melodify" />

        <!-- ==================== Player Service (Foreground Service) ==================== -->
        <!--
            Foreground service responsible for media playback in the background.
            Required by ExoPlayer and MediaSession to continue playing when app is in background.
            type="mediaPlayback" indicates this is a media playback service (Android 14+).
        -->
        <service
            android:name=".core.player.PlaybackService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <!--
                The service MUST be started as a foreground service with a notification.
                The notification is controlled via MediaSession.
            -->
        </service>

        <!-- ==================== Download Service (Optional, WorkManager handles this) ==================== -->
        <!--
            Note: Downloads are handled by WorkManager, so no separate service is needed.
            However, if using a custom download service, it would be defined here.
        -->

        <!-- ==================== Firebase Configuration ==================== -->
        <!--
            Firebase uses the google-services.json file and the following meta-data
            is automatically merged. No explicit meta-data is required if the plugin is used.
        -->

        <!-- ==================== File Provider (For sharing files) ==================== -->
        <!--
            FileProvider is required for sharing downloaded songs or images
            with other apps (e.g., sharing a song file via WhatsApp).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ==================== Meta Data ==================== -->
        <!--
            App version and other meta-data can be placed here if needed.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            tools:node="remove" />

    </application>

</manifest>